# ──────────────────────────────────────────────────────────────────────
# MF FAQ Assistant — Environment Configuration
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!

# ── LLM Settings ──
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=256

# Groq API Key (required when LLM_PROVIDER=groq)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (required when LLM_PROVIDER=openai)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Embedding Settings ──
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Vector Store Settings ──
VECTOR_STORE_PATH=./data/chroma_db
VECTOR_STORE_COLLECTION=mf_faq_corpus

# ── Retrieval Settings ──
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.6
RETRIEVAL_MMR_LAMBDA=0.7

# ── Chunking Settings ──
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_TOKENS=50

# ── API Settings ──
API_RATE_LIMIT=30/minute
API_CORS_ORIGINS=["http://localhost:3000"]
API_PORT=8000

# ── Scraping Settings ──
# Seconds to wait between Groww requests (respect rate limits)
SCRAPING_DELAY=5.0
# Maximum retry attempts per URL
SCRAPING_MAX_RETRIES=3
# Timeout for page load (seconds)
SCRAPING_TIMEOUT=30
# Minimum character count to accept a scraped page
MIN_CONTENT_LENGTH=500

# ── Allowed Domains (comma-separated) ──
ALLOW_DOMAINS=["groww.in"]
