# Streamlit Cloud Secrets Configuration
# Copy this file to .streamlit/secrets.toml and fill in your values
# For Streamlit Cloud deployment, add these secrets in the dashboard:
# App → Settings → Secrets

# Required
GROQ_API_KEY = "your_groq_api_key_here"

# Optional - LLM Configuration
LLM_PROVIDER = "groq"
LLM_MODEL = "llama-3.1-8b-instant"
LLM_TEMPERATURE = "0.0"
LLM_MAX_TOKENS = "256"

# Optional - OpenAI (for dual-client setup)
# OPENAI_API_KEY = "your_openai_api_key_here"

# Optional - Hugging Face (for faster model downloads)
# HF_TOKEN = "your_hf_token_here"
