{
  "$schema": "https://nixpacks.com/docs/schema.json",
  "phases": {
    "setup": {
      "nixPkgs": ["python311"]
    },
    "install": {
      "cmds": [
        "python3 -m venv --copies .venv",
        ". .venv/bin/activate",
        "pip install --upgrade pip",
        "pip install -r requirements.txt"
      ]
    }
  },
  "start": {
    "cmd": "python3 -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
